# PUBLIC browser configuration for a private authenticated Money Garden backend.
# Set via GitHub Actions build variables for Pages or a PRIVATE local .env file.
# These values are public identifiers, NOT secret account credentials.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# NEVER place any of these in VITE_* values, client files, GitHub, or an exported
# Money Garden starter JSON: PLAID_SECRET, PLAID_CLIENT_ID,
# SUPABASE_SERVICE_ROLE_KEY, MONEY_GARDEN_TOKEN_KEY, MONEY_GARDEN_CRON_SECRET.
